{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "shipment_value_chart",
  "position": {
    "x": 800,
    "y": 20,
    "z": 1,
    "height": 420,
    "width": 460,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_delivery"
                    }
                  },
                  "Property": "folder_name"
                }
              },
              "queryRef": "dim_delivery.folder_name",
              "nativeQueryRef": "folder_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Declared Batch Value RUB"
                }
              },
              "queryRef": "_Measures.Declared Batch Value RUB",
              "nativeQueryRef": "Declared Batch Value RUB"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
