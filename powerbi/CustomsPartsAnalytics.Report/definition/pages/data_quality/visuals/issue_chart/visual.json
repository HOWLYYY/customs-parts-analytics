{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "issue_chart",
  "position": {
    "x": 800,
    "y": 20,
    "z": 1,
    "height": 420,
    "width": 460,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "data_quality_issue"
                    }
                  },
                  "Property": "issue_type"
                }
              },
              "queryRef": "data_quality_issue.issue_type",
              "nativeQueryRef": "issue_type"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Quality Issue Rows"
                }
              },
              "queryRef": "_Measures.Quality Issue Rows",
              "nativeQueryRef": "Quality Issue Rows"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
